{
  "name": "@angular/cli",
  "version": "22.3.0",
  "description": "CLI tool for Angular",
  "main": "lib/cli/index.js",
  "typings": "index.d.ts",
  "type": "module",
  "bin": {
    "ng": "bin/ng.js"
  },
