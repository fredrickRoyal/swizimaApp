    "Angular CLI",
    "Angular DevKit",
    "angular",
    "angular-cli",
    "devkit",
    "sdk"
  ],
  "imports": {
    "#version": "./bin/version.js"
  },
  "dependencies": {
    "@angular-devkit/architect": "0.2203.0",
    "@angular-devkit/core": "22.3.0",
    "@angular-devkit/schematics": "22.3.0",
    "@inquirer/prompts": "8.8.0",
    "@listr2/prompt-adapter-inquirer": "4.3.4",
    "@modelcontextprotocol/server": "2.4.0",
    "@schematics/angular": "22.3.0",
    "jsonc-parser": "3.3.1",
    "listr2": "11.4.1",
    "npm-package-arg": "14.0.0",
    "parse5-html-rewriting-stream": "8.1.1",
    "semver": "7.8.6",
    "yargs": "18.2.0",
    "zod": "4.6.7"
